START TRANSACTION;

UPDATE `orders`
SET
  `customer_email` = CASE
    WHEN JSON_VALID(`data`) THEN COALESCE(
      NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.customer.email')), 'null'),
      ''
    )
    ELSE COALESCE(`customer_email`, '')
  END,
  `customer_address` = CASE
    WHEN JSON_VALID(`data`) THEN COALESCE(
      NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.customer.address')), 'null'),
      ''
    )
    ELSE COALESCE(`customer_address`, '')
  END,
  `shipping_area_id` = CASE
    WHEN JSON_VALID(`data`) THEN COALESCE(
      NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.shippingAreaId')), 'null'),
      ''
    )
    ELSE COALESCE(`shipping_area_id`, '')
  END,
  `shipping_area_name` = CASE
    WHEN JSON_VALID(`data`) THEN COALESCE(
      NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.shippingAreaName')), 'null'),
      ''
    )
    ELSE COALESCE(`shipping_area_name`, '')
  END,
  `payment_method_id` = CASE
    WHEN JSON_VALID(`data`) THEN COALESCE(
      NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.paymentMethodId')), 'null'),
      ''
    )
    ELSE COALESCE(`payment_method_id`, '')
  END,
  `payment_method_name` = CASE
    WHEN JSON_VALID(`data`) THEN COALESCE(
      NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.paymentMethodName')), 'null'),
      ''
    )
    ELSE COALESCE(`payment_method_name`, '')
  END,
  `transaction_id` = CASE
    WHEN JSON_VALID(`data`) THEN COALESCE(
      NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.transactionId')), 'null'),
      ''
    )
    ELSE COALESCE(`transaction_id`, '')
  END,
  `order_note` = CASE
    WHEN JSON_VALID(`data`) THEN COALESCE(
      NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.note')), 'null'),
      ''
    )
    ELSE COALESCE(`order_note`, '')
  END,
  `coupon_code` = CASE
    WHEN JSON_VALID(`data`) THEN COALESCE(
      NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.couponCode')), 'null'),
      ''
    )
    ELSE COALESCE(`coupon_code`, '')
  END,
  `subtotal` = CASE
    WHEN JSON_VALID(`data`) THEN CAST(
      COALESCE(
        NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.subtotal')), 'null'),
        '0'
      ) AS DECIMAL(14,2)
    )
    ELSE COALESCE(`subtotal`, 0)
  END,
  `shipping_fee` = CASE
    WHEN JSON_VALID(`data`) THEN CAST(
      COALESCE(
        NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.shippingFee')), 'null'),
        '0'
      ) AS DECIMAL(14,2)
    )
    ELSE COALESCE(`shipping_fee`, 0)
  END,
  `discount` = CASE
    WHEN JSON_VALID(`data`) THEN CAST(
      COALESCE(
        NULLIF(JSON_UNQUOTE(JSON_EXTRACT(`data`, '$.discount')), 'null'),
        '0'
      ) AS DECIMAL(14,2)
    )
    ELSE COALESCE(`discount`, 0)
  END,
  `items_data` = CASE
    WHEN JSON_VALID(`data`) THEN JSON_EXTRACT(`data`, '$.items')
    ELSE COALESCE(`items_data`, JSON_ARRAY())
  END;

COMMIT;

SELECT
  `id`,
  `order_number`,
  `customer_name`,
  `customer_email`,
  `shipping_area_name`,
  `payment_method_name`,
  `transaction_id`,
  `order_note`,
  `subtotal`,
  `shipping_fee`,
  `discount`,
  `total`
FROM `orders`
ORDER BY `created_at` DESC
LIMIT 20;
